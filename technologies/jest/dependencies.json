{
  "packages": [
    { "name": "jest", "version": "^30.4.0", "dev": true },
    { "name": "@types/jest", "version": "^30.0.0", "dev": true }
{{#if has.react-native}}    ,{ "name": "jest-expo", "version": "^57.0.0", "dev": true }
    ,{ "name": "@testing-library/react-native", "version": "^14.0.0", "dev": true }
{{/if}}{{#unless has.react-native}}    ,{ "name": "jest-environment-jsdom", "version": "^30.0.0", "dev": true }
    ,{ "name": "@testing-library/react", "version": "^16.3.0", "dev": true }
    ,{ "name": "@testing-library/jest-dom", "version": "^6.6.0", "dev": true }
{{/unless}}  ],
  "install": [
{{#if has.react-native}}    "npx expo install -- --save-dev jest jest-expo @testing-library/react-native @types/jest"
{{/if}}{{#unless has.react-native}}    "npm install -D jest jest-environment-jsdom @types/jest @testing-library/react @testing-library/jest-dom"
{{/unless}}  ]
}
