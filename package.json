{
  "name": "ai-project-bootstrap",
  "version": "1.3.1",
  "description": "Generate and maintain an AI-assisted dev environment tailored to your stack: rules for Cursor, Claude Code and 6 more AI tools, docs, prompts, cost estimates and starter templates, plus check, review, analyze, implement, doctor and upgrade commands.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai",
    "scaffolding",
    "generator",
    "cursor",
    "claude",
    "boilerplate",
    "developer-experience"
  ],
  "bin": {
    "ai-project-bootstrap": "dist/index.js",
    "apb": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "technologies",
    "config",
    "features",
    "archetypes"
  ],
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "tsup",
    "check:publishable": "node scripts/check-publishable.mjs",
    "dev": "tsup --watch",
    "docs:tech-table": "node scripts/generate-tech-table.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build && pnpm check:publishable",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "picocolors": "^1.0.1",
    "semver": "^7.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/semver": "^7.5.8",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorishchenko/ai-project-bootstrap.git"
  },
  "homepage": "https://ai-project-bootstrap.com/",
  "bugs": {
    "url": "https://github.com/igorishchenko/ai-project-bootstrap/issues"
  }
}
