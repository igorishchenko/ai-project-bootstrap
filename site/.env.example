# Origin of the hosted backend (ai-project-bootstrap-cloud). Defaults to
# http://localhost:8787 when unset, matching the CLI's own default.
#
# The browser calls this directly with credentials, so the backend's
# APP_BASE_URL must be this site's origin — that value is its CORS allow-list
# and the base for magic links. The two must agree or sign-in silently fails.
NEXT_PUBLIC_API_URL=http://localhost:8787
