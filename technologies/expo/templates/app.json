{
  "expo": {
    "name": "{{projectName}}",
    "slug": "{{projectSlug}}",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.example.{{projectSlug}}",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.{{projectSlug}}",
      "versionCode": 1
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
